[importlinter]
root_package = lib_finder
include_external_packages = True

[importlinter:contract:lightweight-import-boundary-modules]
name = Lightweight import boundary modules
type = forbidden
source_modules =
    lib_finder
    lib_finder.cli
    lib_finder.settings
    lib_finder.storage
    lib_finder.sources.pypi
forbidden_modules =
    langextract
    haystack
    ollama
as_packages = False
